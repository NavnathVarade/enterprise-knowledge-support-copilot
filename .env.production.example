# PRODUCTION / STAGING template. NOT for a laptop: use .env.example for local development.
# Inject these through your secret manager / Kubernetes Secrets (never commit real values).
# Hosts below MUST be service-discovery names (Docker Compose service names or
# Kubernetes DNS), never localhost/127.0.0.1 — enforced at startup for
# environment=staging|production (see packages/config/settings.py).
# Production REQUIRES Kafka: KAFKA_ENABLED=false and an empty KAFKA_BOOTSTRAP_SERVERS are rejected.

ENVIRONMENT=production

DATABASE_URL=postgresql+asyncpg://ekc_app:__SECRET__@postgres.default.svc.cluster.local:5432/ekc
DATABASE_READ_ONLY_ROLE_URL=postgresql+asyncpg://ekc_analytics_ro:__SECRET__@postgres-replica.default.svc.cluster.local:5432/ekc
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://redis.default.svc.cluster.local:6379/0

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka-0.kafka.default.svc.cluster.local:9092,kafka-1.kafka.default.svc.cluster.local:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=ekc
KAFKA_SASL_PASSWORD=__SECRET__
KAFKA_SSL_CA_LOCATION=/etc/ekc/kafka-ca/ca.crt

# Secrets: inject from your secret manager (K8s Secret / Vault), never commit real values.
LLM_API_KEY=__SECRET__
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-haiku-4-5

# Voyage key; also used by the reranker. Staging/production refuse to start without it.
EMBEDDING_API_KEY=__SECRET__
EMBEDDING_PROVIDER=anthropic
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024

SECURITY_JWT_PUBLIC_KEY="__PEM_PUBLIC_KEY__"
# Only the token-issuing path (the /api/v1/auth/login route) needs the private key.
# In a larger deployment this key would live only on a dedicated auth service, not on
# every API replica -- here they're the same service (Section 145's modular-monolith
# call), so both live in the same secret.
SECURITY_JWT_PRIVATE_KEY="__PEM_PRIVATE_KEY__"
SECURITY_JWT_ISSUER=ekc-prod
SECURITY_JWT_AUDIENCE=ekc-api
SECURITY_ACCESS_TOKEN_TTL_SECONDS=900

OTEL_SERVICE_NAME=enterprise-knowledge-copilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
OTEL_LOG_LEVEL=INFO

RATE_LIMIT_TENANT_QUERIES_PER_MINUTE=120
RATE_LIMIT_USER_QUERIES_PER_MINUTE=30

# Object storage for uploaded originals (S3 or S3-compatible). Credentials come from the
# workload identity / IAM role (IRSA) -- never put access keys in this file.
OBJECT_STORE_BUCKET=ekc-documents-prod
OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_ENDPOINT_URL=https://minio.storage.svc.cluster.local:9000
OBJECT_STORE_SSE=aws:kms
# OBJECT_STORE_KMS_KEY_ID=arn:aws:kms:...
OTEL_METRICS_BEARER_TOKEN=__SECRET__

# --- Cost monitoring (Phase 31). All optional: unset price => cost is recorded as unknown.
# LLM_INPUT_USD_PER_MILLION_TOKENS=   # set a number to enable; leave unset (NOT empty) otherwise
# LLM_OUTPUT_USD_PER_MILLION_TOKENS=   # set a number to enable; leave unset (NOT empty) otherwise
# LLM_FALLBACK_INPUT_USD_PER_MILLION_TOKENS=   # set a number to enable; leave unset (NOT empty) otherwise
# LLM_FALLBACK_OUTPUT_USD_PER_MILLION_TOKENS=   # set a number to enable; leave unset (NOT empty) otherwise
# EMBEDDING_USD_PER_MILLION_TOKENS=   # set a number to enable; leave unset (NOT empty) otherwise
USAGE_METERING_ENABLED=true
# USAGE_DEFAULT_DAILY_TOKEN_LIMIT=   # set a number to enable; leave unset (NOT empty) otherwise
# USAGE_DEFAULT_DAILY_COST_USD_LIMIT=   # set a number to enable; leave unset (NOT empty) otherwise
USAGE_BUDGET_FAIL_OPEN=true

# --- HTTP hardening (Phase 32)
HARDENING_TRUSTED_PROXY_HOPS=1          # reverse proxies whose X-Forwarded-For you trust; 0 = none
HARDENING_DOCS_ENABLED=false            # /docs, /redoc, /openapi.json (unset = dev/test only)
HARDENING_MAX_REQUEST_BODY_BYTES=1048576
HARDENING_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
HARDENING_LOGIN_MAX_FAILURES_PER_IP=30
HARDENING_LOGIN_WINDOW_SECONDS=900
HARDENING_LOGIN_THROTTLE_FAIL_OPEN=true

# --- Retrieval (pgvector HNSW) tuning -- leave unset unless measured on your data ---
# Requires pgvector >= 0.8 for ITERATIVE_SCAN; setting it on 0.6/0.7 makes queries fail.
# RETRIEVAL_HNSW_EF_SEARCH=100
# RETRIEVAL_HNSW_ITERATIVE_SCAN=relaxed_order
# RETRIEVAL_HNSW_MAX_SCAN_TUPLES=20000

# --- Resilience (Phase 34) ---
# DATABASE_CONNECT_TIMEOUT_SECONDS=5
# HEALTH_CHECK_TIMEOUT_SECONDS=3
# HEALTH_REDIS_REQUIRED=false   # unset = required only if the login throttle fails closed

# Compose-only variables (POSTGRES_PASSWORD, METRICS_TOKEN, ...) live in .env.compose.example.
