# Local test-harness environment template.
# Real deployments use Docker Compose / Kubernetes service DNS.
# See .env.example.

ENVIRONMENT=test

# PostgreSQL test database
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# Redis
REDIS_URL=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# JWT test configuration
SECURITY_JWT_PUBLIC_KEY=
SECURITY_JWT_PRIVATE_KEY=
SECURITY_JWT_ISSUER=
SECURITY_JWT_AUDIENCE=

# Observability
OTEL_SERVICE_NAME=enterprise-knowledge-copilot-test
OTEL_LOG_LEVEL=INFO

# Test hardening configuration
# A high threshold prevents intentional failed-login tests
# from interfering with one another.
HARDENING_LOGIN_MAX_FAILURES_PER_IP=100000