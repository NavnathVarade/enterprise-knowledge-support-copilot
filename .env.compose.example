# Variables the Compose reference stack requires. Copy to `.env.compose`, replace every
# placeholder, and run:   docker compose --env-file .env.compose -f infrastructure/docker/docker-compose.yml up -d
# (JWT keys and provider API keys live in .env, see .env.production.example.) Never commit real values.
POSTGRES_PASSWORD=__SECRET__
MINIO_ROOT_PASSWORD=__SECRET__
ANALYTICS_RO_PASSWORD=__SECRET__
# Bearer token for /metrics (API and workers); Prometheus reads the same value.
METRICS_TOKEN=__SECRET__
# Only with docker-compose.observability.yml:
GRAFANA_ADMIN_PASSWORD=__SECRET__
# Optional: GATEWAY_BIND (default 127.0.0.1), GATEWAY_PORT (8080), OBSERVABILITY_BIND (127.0.0.1)
