{
  "title": "Enterprise Knowledge Copilot \u2014 Overview",
  "uid": "ekc-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "ekc"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by status class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(ekc_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ekc_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ekc_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ekc_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queries by route and status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(ekc_query_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Abstentions by reason",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(ekc_answer_abstentions_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM calls by outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(ekc_llm_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM tokens/s and spend (only if priced)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(ekc_llm_tokens_total[5m]))",
          "legendFormat": "tokens {{direction}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ekc_llm_cost_usd_total[1h])) * 3600",
          "legendFormat": "USD/hour"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (topic) (ekc_kafka_consumer_lag_messages)",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka message outcomes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, outcome) (rate(ekc_kafka_messages_total[5m]))",
          "legendFormat": "{{topic}} {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbox backlog and oldest age",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ekc_outbox_unpublished_events",
          "legendFormat": "unpublished"
        },
        {
          "refId": "B",
          "expr": "ekc_outbox_oldest_unpublished_age_seconds",
          "legendFormat": "oldest age (s)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingestion outcomes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(ekc_ingestion_documents_total[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingestion stage p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(ekc_ingestion_stage_duration_seconds_bucket[15m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Security signals",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ekc_injection_chunks_quarantined_total[1h]))",
          "legendFormat": "injection quarantined"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ekc_output_policy_violations_total[1h]))",
          "legendFormat": "output policy"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ekc_citation_validation_failures_total[1h]))",
          "legendFormat": "citation failures"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ekc_audit_write_failures_total[1h]))",
          "legendFormat": "audit write failures"
        }
      ]
    }
  ],
  "description": "Generated starting point. Not exercised against a live Grafana; thresholds/units untuned."
}