# LOCAL DEVELOPMENT template (Windows / macOS / Linux, no Docker, no Kafka).
#
#   uv run python -m scripts.init_dev_env        # copies this file to .env and generates
#                                                # a fresh JWT keypair (never committed)
#
# Precedence: real environment variables > .env > built-in defaults. Empty values count as unset.
# Production uses .env.production.example instead (every endpoint explicit, Kafka required).

ENVIRONMENT=development

# --- PostgreSQL (required; pgvector extension must be installed). Percent-encode special
# --- characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
DATABASE_URL=postgresql+asyncpg://ekc_app:__LOCAL_PASSWORD__@localhost:5432/ekc
# Optional read-only role for SQL analytics. Empty => analytics use DATABASE_URL (dev only).
DATABASE_READ_ONLY_ROLE_URL=

# --- Redis (required for throttling/rate limits/idempotency; degrades to "degraded" if down).
# Windows: Memurai, Redis in WSL2, or any Redis >= 6 listening on localhost.
REDIS_URL=redis://localhost:6379/0

# --- Kafka: OFF for local development. Events are handled by an in-process dispatcher that
# --- reads the Postgres outbox (see docs/adr/ADR-011). Leave the brokers empty.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=

# --- Uploaded originals: local disk (no S3 needed). Set OBJECT_STORE_BUCKET to use S3 instead.
OBJECT_STORE_LOCAL_DIRECTORY=.local-data/object-store
OBJECT_STORE_BUCKET=

# --- JWT signing keys: generated for you by scripts.init_dev_env.
SECURITY_JWT_PUBLIC_KEY="__GENERATED_BY_INIT_DEV_ENV__"
SECURITY_JWT_PRIVATE_KEY="__GENERATED_BY_INIT_DEV_ENV__"
SECURITY_JWT_ISSUER=ekc-dev
SECURITY_JWT_AUDIENCE=ekc-api

# --- AI providers. Without keys the app still runs: ingestion uses a deterministic, NON-semantic
# --- embedding stand-in and /api/v1/query returns a configuration error (no key => no answers).
# --- Add real keys here to get real retrieval quality and generated answers.
LLM_API_KEY=
EMBEDDING_API_KEY=

OTEL_LOG_LEVEL=INFO
